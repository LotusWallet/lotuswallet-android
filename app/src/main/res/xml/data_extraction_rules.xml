<?xml version="1.0" encoding="utf-8"?>
<!--
  禁止任何形式的云备份 / 设备迁移自动搬运数据。
  钱包数据库里虽然只有密文，但把密文交给云盘会平白扩大攻击面；
  用户的备份方式是「自己导出的加密备份文件」，不是系统云备份。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
