    <!-- ============================================================ About -->
    <string name="about_title">About LotusWallet</string>
    <string name="about_slogan">Self-custody · Local encryption · No backend</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_body">No sign-up, no device identifiers, no usage tracking. All keys and vault contents are stored on this device as ciphertext. Balances and history come from public blockchain nodes, and those requests carry nothing that identifies you.</string>
    <string name="about_security_title">Security design</string>
    <string name="about_security_body">Your master password is stretched with Argon2id into a key-encrypting key (KEK) that exists in memory only while unlocked. The data encryption key (DEK) is stored wrapped by the KEK, so changing the password only re-wraps it once. Biometric unlock relies on a non-exportable key inside the secure element.</string>
